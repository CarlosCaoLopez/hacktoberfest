# MQTT broker
MQTT_BROKER=localhost
MQTT_PORT=1883

# Chatbot topics para enviar comandos
CHATBOT_TOPIC_DRONES_REGISTER=chatbot/drones/register
CHATBOT_TOPIC_DRONES_AVAILABLE=chatbot/drones/available
CHATBOT_TOPIC_DRONES_LOAD=chatbot/drones/+ /load
CHATBOT_TOPIC_DRONES_MEDICATIONS=chatbot/drones/+/medications
CHATBOT_TOPIC_DRONES_BATTERY=chatbot/drones/+/battery

# Chatbot topic para recibir respuestas
MQTT_TOPIC_DRONES_REGISTER_RESPONSE=api/drones/register/response
MQTT_TOPIC_DRONES_AVAILABLE_RESPONSE=api/drones/available/response
MQTT_TOPIC_DRONES_LOAD_RESPONSE=api/drones/+/load/response
MQTT_TOPIC_DRONES_MEDICATIONS_RESPONSE=api/drones/+/medications/response
MQTT_TOPIC_DRONES_BATTERY_RESPONSE=api/drones/+/battery/response

# Chatbot topic para recibir alertas
MQTT_TOPIC_DRONES_ALERT_BATTERY_LOW=drones/+/alert/battery_low
MQTT_TOPIC_DRONES_ALERT_STATE=drones/+/alert/state_change
MQTT_TOPIC_DRONES_ALERT_ERROR=drones/+/alert/error

# Topic de salida del chatbot hacia el usuario
CHATBOT_TOPIC_OUT=chatbot/output

# MongoDB configuration (matches docker-compose.yml)
MONGODB_URL=mongodb://root:hacktoberfest@localhost:27017
DATABASE_NAME=drone_dispatch